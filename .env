# Copy this file to .env before running docker compose up

# --- Database ---
POSTGRES_USER=pia_user
POSTGRES_PASSWORD=pia_pass
POSTGRES_DB=product_intelligence

# --- AI Provider (fill in later, not needed for Phase 0/1) ---
GROQ_API_KEY=Add_Your_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b

# --- Embeddings (Phase 1/4) — 384 matches all-MiniLM-L6-v2 ---
EMBEDDING_DIM=384
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking (Phase 4) ---
CHUNK_SIZE_WORDS=500
CHUNK_OVERLAP_WORDS=50

# --- App ---
ENV=development
